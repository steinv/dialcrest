{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "twilio-phone-peblet",
          "appId": "1:917581683919:android:0fdfd4147afdbd0d172bba",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "twilio-phone-peblet",
          "appId": "1:917581683919:ios:02f324e3f21d9d54172bba",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "twilio-phone-peblet",
          "configurations": {
            "android": "1:917581683919:android:0fdfd4147afdbd0d172bba",
            "ios": "1:917581683919:ios:02f324e3f21d9d54172bba"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/faq",
        "destination": "/faq.html"
      }
    ]
  }
}