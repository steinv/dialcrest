# Copy to fastlane/.env (gitignored) — fastlane loads it automatically.

# Google Play: service-account JSON key with release permissions on the app.
# Defaults to ~/.config/dialcrest/play-service-account.json when unset.
# PLAY_JSON_KEY_PATH=/Users/you/.config/dialcrest/play-service-account.json

# App Store Connect API key (Users and Access → Integrations → App Store Connect API).
# ASC_KEY_ID=ABC123DEFG
# ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ASC_KEY_PATH=/Users/you/.config/dialcrest/AuthKey_ABC123DEFG.p8
