{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    ".read": false,
    ".write": false,
    "twilio": {
      "$accountSid": {
        /* Account-scoped access is gated on the `accountSid` custom claim set by
           the twilioLinkAccount function once Twilio credentials are verified,
           so only a client that proved ownership of the account can read or
           write its data. */
        "subscription": {
          ".read": "auth.token.accountSid === $accountSid"
        },
        "configuration": {
          ".read": "auth.token.accountSid === $accountSid",
          ".write": "auth.token.accountSid === $accountSid",
          "advancedNumberConfig": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
