{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    ".read": false,
    ".write": false,
    "twilio": {
      "$accountSid": {
        /* Twilio Auth Token, stored for webhook X-Twilio-Signature validation.
           Cloud Functions (Admin SDK) only — never readable/writable by clients. */
        "secret": {
          ".read": false,
          ".write": false
        },
        /* License override: an epoch-ms timestamp set by hand in the Firebase
           console (licenses every device on the line until then). Readable by
           the account so Settings can show it; never client-writable. */
        "licenseOverride": {
          ".read": "auth.token.accountSid === $accountSid"
        },
        "twiml-app-sid": {
          ".read": "auth.token.accountSid === $accountSid"
        },
        "configuration": {
          ".read": "auth.token.accountSid === $accountSid",
          ".write": "auth.token.accountSid === $accountSid",
          "advancedNumberConfig": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
